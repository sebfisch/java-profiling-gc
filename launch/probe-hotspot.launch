<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<launchConfiguration type="org.eclipse.jdt.launching.localJavaApplication">
    <stringAttribute key="org.eclipse.jdt.launching.PROJECT_ATTR" value="java-profiling-gc"/>
    <stringAttribute key="org.eclipse.jdt.launching.MAIN_TYPE" value="sebfisch.probes.CpuHotspot"/>
    <stringAttribute key="org.eclipse.jdt.launching.VM_ARGUMENTS" value="-XX:+UseG1GC -Xmx1g -Xlog:gc*:file=logs/probe-hotspot.log"/>
</launchConfiguration>
