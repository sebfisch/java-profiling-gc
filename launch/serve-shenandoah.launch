<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<launchConfiguration type="org.eclipse.jdt.launching.localJavaApplication">
    <stringAttribute key="org.eclipse.jdt.launching.PROJECT_ATTR" value="java-profiling-gc"/>
    <stringAttribute key="org.eclipse.jdt.launching.MAIN_TYPE" value="sebfisch.statements.ServeMain"/>
    <stringAttribute key="org.eclipse.jdt.launching.VM_ARGUMENTS" value="-XX:+UseShenandoahGC -Xmx1g -Xlog:gc*:file=logs/serve-shenandoah.log"/>
    <stringAttribute key="org.eclipse.jdt.launching.PROGRAM_ARGUMENTS" value="8 20 5000 100000"/>
</launchConfiguration>
